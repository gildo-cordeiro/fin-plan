# ===============================================
# FinPlan — Variáveis de Ambiente (Monorepo)
# ===============================================

# -----------------------------------------------
# Backend Go (apps/api)
# -----------------------------------------------
# String de conexão PostgreSQL (obrigatória)
DATABASE_URL=postgres://finplan:finplan@localhost:5432/finplan?sslmode=disable

# Porta HTTP do servidor Go (padrão: 8080)
PORT=8080

# Chave secreta da API (opcional para desenvolvimento local, recomendada em produção)
API_SECRET_KEY=sua-chave-secreta-aqui

# -----------------------------------------------
# Frontend Web (apps/web)
# -----------------------------------------------
# Chave de API enviada no cabeçalho x-api-key pelo frontend (deve ser idêntica a API_SECRET_KEY)
VITE_API_SECRET_KEY=sua-chave-secreta-aqui

# URL base da API (opcional)
# - Em dev local: deixe vazio ou comente (o Vite faz proxy automático de /api para http://localhost:8080)
# - Em produção na Vercel: defina a URL pública do seu backend Go (ex: https://sua-api.fly.dev)
# VITE_API_URL=https://api.finplan.example.com
