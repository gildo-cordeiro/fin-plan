# Frontend — variáveis prefixadas com VITE_ são injetadas no bundle do navegador

# Chave de API enviada no header x-api-key (deve coincidir com API_SECRET_KEY do backend)
VITE_API_SECRET_KEY=sua-chave-secreta-aqui

# URL base da API Go (opcional):
# - Em desenvolvimento local: não é necessário definir (o Vite faz proxy automático de /api para http://localhost:8080)
# - Em produção na Vercel: defina a URL pública do seu backend Go (ex: https://sua-api.fly.dev)
# VITE_API_URL=https://api.finplan.example.com
